<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="28dp"
    android:paddingRight="28dp">

    <LinearLayout
        android:id="@+id/card_scan"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:background="@drawable/bg_home_card_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="28dp"
        android:paddingRight="28dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/scan_title"
                android:src="@drawable/ic_camera"
                android:tint="@color/accent" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_weight="1"
            android:text="@string/scan_title"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/scan_title"
            android:src="@drawable/ic_chevron"
            android:tint="@color/text3" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_generate"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_home_card_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="28dp"
        android:paddingRight="28dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/generate_title"
                android:src="@drawable/ic_make"
                android:tint="@color/accent" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_weight="1"
            android:text="@string/generate_title"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/generate_title"
            android:src="@drawable/ic_chevron"
            android:tint="@color/text3" />
    </LinearLayout>
</LinearLayout>